{% if api_module -%}
// `useHello` is generated by orval from the backend module's OpenAPI schema
// (run `pnpm run build:modules`, which regenerates `src/api/{{ api_module }}.ts`).
import { useHello } from "../api/{{ api_module }}";

export default function Hello() {
  const { data, isPending, isError } = useHello();

  return (
    <div>
      <h1>{{ module_label | trim }}</h1>
      <p>
        {isPending
          ? "Loading…"
          : isError
            ? "Could not reach the backend module."
            : data?.message}
      </p>
      <p>
        Edit this frontend module and the <code>{{ api_module }}</code> backend
        module to build your own module.
      </p>
    </div>
  );
}
{%- else -%}
export default function Hello() {
  return (
    <div>
      <h1>{{ module_label | trim }}</h1>
      <p>
        Edit <code>src/routes/Hello.tsx</code> to build your own module.
      </p>
    </div>
  );
}
{%- endif %}
